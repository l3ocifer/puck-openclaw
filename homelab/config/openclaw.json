{
  // OpenClaw config for Puck — creative agent. Poems, books, videos,
  // music. Floats; soft-prefers thebeast for RAM. Internal-facing
  // (Frack publishes anything that goes to the world).

  models: {
    mode: "merge",
    providers: {
      // Override the built-in `openai` provider so the OpenClaw embedded
      // harness — which falls back to `openai/gpt-5.5` when the
      // agentRuntime is left unspecified — routes through the same
      // LiteLLM gateway as the main agent. The matching `gpt-5.5 -> chat`
      // alias lives in homelab argocd/apps/_inference/40-litellm-config.yaml.
      openai: {
        baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
        apiKey: { source: "env", provider: "default", id: "OPENAI_API_KEY" },
        api: "openai-completions",
        // Cluster-internal LiteLLM resolves to a private Service IP; the
        // model-fetch SSRF guard blocks private/internal targets unless we
        // opt in for this operator-controlled endpoint. Without this the
        // embedded harness fails every call with SsrFBlockedError.
        request: { allowPrivateNetwork: true },
        models: [
          {
            id: "gpt-5.5",
            name: "Embedded harness fallback — alias to LiteLLM chat",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 8192,
          }
        ]
      },
      litellm: {
        baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
        apiKey: { source: "env", provider: "default", id: "LITELLM_API_KEY" },
        api: "openai-completions",
        // See note on the openai provider above — allow the SSRF guard to
        // reach the cluster-internal LiteLLM Service (private ClusterIP).
        request: { allowPrivateNetwork: true },
        models: [
          {
            id: "chat",
            name: "Puck default (vllm-chat / Qwen3.5 27B AWQ)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            // Real backend max_model_len is 24576 (vllm /v1/models). The old
            // 20480 understated it; combined with the 20K reserve-floor default
            // (capped to 80% of the window = 16384) it left only ~8K usable
            // prompt, so any long mission/a2a thread wedged in a compact-retry
            // loop with no escape. Use the true window; reserve floor lowered
            // to 6000 below (see agents.defaults.compaction.ln).
            contextWindow: 24576,
            maxTokens: 4096,
          },
          {
            id: "long",
            name: "Long context (vllm-long / Qwen3.5 9B AWQ + DeltaNet, 262K)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 262144,
            maxTokens: 8192,
          },
          {
            id: "frontier",
            name: "Frontier — careful prose (Qwen3-Coder 480B MoE, slow / opt-in)",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 65536,
            maxTokens: 8192,
          },
          {
            id: "embed",
            name: "Embeddings for portfolio search",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 8192,
          },
          {
            id: "tts",
            name: "Text-to-speech",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 4096,
          },
          {
            id: "transcribe",
            name: "Whisper transcription",
            reasoning: false,
            input: ["audio"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
          },
          {
            id: "image",
            name: "Image generation",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 4096,
          },

          // ─── Claude Max (via household claude-bridge) ──────────────
          // Tier-6 budget share: 8% of weekly Claude pool. Puck is the
          // creative agent; reserve the paid model for the moments
          // where prose quality on user-facing output actually matters:
          //   - finalizing a poem before Frack publishes
          //   - long-form (10K+ word) draft of a blog/short story
          //   - a one-off song/lyric that needs tight metric craft
          // First/second drafts and ideation stay on `chat` / `frontier`.
          // Bridge policy enforces both the 7-day quota and Puck's 8%
          // share. The agent may choose any Claude Code model at call
          // time via claude-code/<cli-model>; on 429 LiteLLM falls back
          // to local models so creative sessions never hard-fail.
          {
            id: "claude-sonnet-max",
            name: "Claude Sonnet 4.6 via household Max subscription",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          },
          {
            id: "claude-opus-max",
            name: "Claude Opus via household Max subscription",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          },
          {
            id: "claude-code/*",
            name: "Claude Code model selected at call time",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          }
        ]
      }
    }
  },

  agents: {
    defaults: {
      model: {
        // Fleet default: chat (vllm-chat / Qwen3.5 27B AWQ on thebeast).
        // Long/frontier are opt-in per-task only; do not auto-fallback to
        // long because a wedged long backend can hang normal agent work.
        primary:   "litellm/chat",
        fallbacks: [],
      },
      // NOTE: previous `agentRuntime: { defaults: {...} }` block removed
      // (AgentRuntimePolicySchema only accepts {id, fallback}). The
      // embedded harness now follows the main model.primary above.
      workspace: "/root/.openclaw/workspace",
      // ln = compaction reserve-token floor. The harness default (20000,
      // capped to 80% of the model window) reserved ~16K of chat's 24K window,
      // leaving only ~8K for the prompt — so long mission/a2a threads overflowed
      // the client precheck (route=compact_only) and looped instead of running.
      // 6000 reserves ample room for chat's 4096-token output + safety while
      // freeing ~18K of prompt budget. Server-side context_window_fallbacks in
      // litellm-config still escalate genuinely huge sessions to long-alef.
      compaction: { mode: "safeguard", ln: 6000 },
      contextPruning: { mode: "cache-ttl", ttl: "2h" },
      maxConcurrent: 4,
      thinkingDefault: "low",
      heartbeat: {
        every: "30m",
        target: "last",  // schema rejects arbitrary URLs as targets;
                          // outbound healthchecks.io ping handled separately.
      },
      memorySearch: {
        enabled: true,
        sources: ["memory", "sessions"],
        extraPaths: [
          "/data/graphs/puck/pages",
          "/data/graphs/puck/journals",
          "/data/graphs/leo/pages",
          "/data/graphs/leo/journals",
          "/data/graphs/frick/pages",
          "/data/graphs/frack/pages",
          "/data/graphs/sancho/pages",
          "/data/graphs/vetinari/pages",
          "/data/graphs/quirm/pages",
          "/data/graphs/vimes/pages",
        ],
        provider: "remote",
        remote: {
          baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
          apiKey: { source: "env", provider: "default", id: "LITELLM_API_KEY" },
        },
        model: "embed",
        fallback: "local",
        local: {
          modelPath: "hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf",
        },
        store: {
          driver: "sqlite",
          path: "/root/.openclaw/workspace-rw/memory/index.sqlite",
          vector: { enabled: true },
        },
        sync: {
          watch: true,
          watchDebounceMs: 2000,
          onSessionStart: true,
          onSearch: true,
        },
        query: {
          hybrid: {
            enabled: true,
            vectorWeight: 0.7,
            textWeight: 0.3,
          },
        },
      },
    },
    list: [
      {
        id: "main",
        default: true,
        identity: {
          name: "Puck",
          theme: "creative — poems, books, videos, music",
          emoji: "🎭",
        },
      }
    ],
  },

  tools: {
    profile: "full",  // schema enum: minimal|coding|messaging|full. Puck does
                       // wide-surface creative work; "full" is the closest fit.
    allow: ["read", "write", "edit", "exec", "web_search", "browser"],
    exec: {
      host: "gateway",
      ask: "always",      // ask before every exec — Puck never silently runs
      security: "allowlist", // schema enum: deny|allowlist|full
      // NOTE: previous `allowedCommands` array was not in ToolExecBaseShape.
      // Allowlist enforcement now lives in the gateway-side runtime tool
      // policy (see scripts/agents/sancho-routines.md and confirm-list).
    },
    elevated: {
      enabled: false,
    },
    // NOTE: previous `tools.confirm` array is not in ToolsSchema. Per-tool
    // confirmation is enforced via the killswitch persona file
    // (KILLSWITCH.md §4 — external_post/external_email/github_push/
    //  github_pr_merge always require explicit `:y`).
  },

  skills: {
    load: {
      extraDirs: ["/data/graphs/puck/pages/skills"],
    },
  },

  gateway: {
    mode: "local",  // schema enum: local|remote — pod foreground == "local"
    port: 18789,
    // Upstream OpenClaw tightened the schema (2026-05): bind must be one of
    // auto|lan|loopback|custom|tailnet. `lan` binds 0.0.0.0 on cluster-internal
    // interfaces, which is what the Service in front of us expects.
    bind: "lan",
  },

  // NOTE: channels block omitted; plugins auto-discover from env vars.
  // See frack-openclaw/homelab/config/openclaw.json for the full
  // rationale. Puck registers on matrix + telegram only (no bluebubbles).

  // NOTE: the previous `hardKill`, `quietHours`, `a2a`, `fleet`, and
  // `cron`-as-array blocks were rejected by the upstream OpenClaw config
  // validator (root schema is .strict() and OpenClaw's `cron` is an
  // object, not a job list). Their semantics live elsewhere now:
  //
  //   - HARDSTOP sentinel: HARDSTOP_PATH env in deployment.yaml
  //     (`/data/HARDSTOP-PUCK`) + persona docs.
  //   - quiet hours: enforced at the persona/skills layer (HEARTBEAT.md
  //     and the messaging adapters honour 22:00-06:30 NY).
  //   - A2A peers: discovered via the bonjour plugin (see openclaw
  //     gateway log: "[plugins] bonjour: advertised gateway fqdn=...").
  //   - fleet event bus: agents emit events directly to FLEET_DATABASE_URL
  //     when scripts/skills do so; no per-agent OpenClaw config.
  //   - cron: scheduled prompts must be created via the gateway API
  //     (POST /api/v1/cron/jobs) at boot or via a one-shot k8s Job
  //     against the Puck pod's gateway. See homelab agents-rollout-runbook.md.
}
